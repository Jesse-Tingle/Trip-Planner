generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id    String @id @default(uuid())
  users User[]
  trips Trip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id       String @id @default(uuid())
  name     String
  username String @unique
  email    String @unique
  password String
  trips    Trip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Account   Account? @relation(fields: [accountId], references: [id])
  accountId String?
}

model Trip {
  id        String @id @default(uuid())
  name      String
  location  String
  travelers Int
  totalCost Float

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  restaurants Restaurant[]
  activities  Activity[]
  hotels      Hotel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Account   Account? @relation(fields: [accountId], references: [id])
  accountId String?
}

model Restaurant {
  id         String  @id @default(uuid())
  name       String
  placeId    String // Google Places ID
  address    String?
  rating     Float?
  priceLevel Int?

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model Activity {
  id      String  @id @default(uuid())
  name    String
  placeId String
  address String?
  rating  Float?

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model Hotel {
  id         String  @id @default(uuid())
  name       String
  placeId    String
  address    String?
  rating     Float?
  priceLevel Int?

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
}
